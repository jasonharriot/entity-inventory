<!DOCTYPE html>

<html>
	<head>
		<link rel="stylesheet" href="style/style.css" />

		<meta name="viewport" content="width=device-width,initial-scale=1.0">

		<title><%= config.get('site_name') %></title>
	</head>
	<body>
		<div id="container">
			<%- include('header.ejs', {backButtonDisabled: true}) %>
			<div id="contentContainer">
				<% if(authenticatedUser && authenticatedUser.permissions.hasAny(['read', 'write', 'issue-ids'])){ %>
				<div class="section">
					<h2>Tools</h2>
					<% if(authenticatedUser.permissions.has('read')){ %>
					<p><a href="search">Search</a>&mdash;<i>Shortcut key: S</i></p>
					<p><a href="card-list">View all cards</a>&mdash;<i>Shortcut key: L</i></p>
					<p><a href="go-to-card">Go to ID number</a>&mdash;<i>Shortcut key: G</i></p>
					<% } %>
					<% if(authenticatedUser.permissions.has('write')){ %>
					<p><a href="bulk-landing">Bulk operations</a></p>
					<% } %>
					<% if(authenticatedUser.permissions.has('issue_ids')){ %>
					<p><a href="issue">Print new labels</a></p>
					<% } %>
				</div>
				<% } %>

				<% if(authenticatedUser && authenticatedUser.permissions.hasAny(['officer'])){ %>
				<div class="section">
					<h2>Administration</h2>
					<p><a href="user-list">User list</a></p>
				</div>
				<% } %>

				<div class="section">
					<h2>
						Info
					</h2>
					<div>
						<p>
							<a href="https://github.com/jasonharriot/entity-inventory">
								Entity Inventory&mdash;GitHub
							</a>
							<% if(authenticatedUser){ %>
							<p><a href="debug">Debugging tools</a></p>
							<% } %>
						</p>
					</div>
					
				</div>
			</div>

			<%- include ('footer.ejs') %>
		</div>

		<script type="text/javascript" src="js/page-scan-watch.js"></script>
		<script type="text/javascript" src="js/page-scan-default.js"></script>
	</body>
</html>
