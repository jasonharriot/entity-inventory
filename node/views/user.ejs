<!DOCTYPE html>

<html>
	<head>
		<link rel="stylesheet" href="style/style.css" />
		<link rel="stylesheet" href="style/issue.css" />

		<meta name="viewport" content="width=device-width,initial-scale=1.0">

		<title>User Profile</title>
	</head>
	<body>
		<div id="container">
			<%- include('header.ejs', {hideLogin:true}) %>
			<div id="contentContainer">
				<div class="section">
					<h2>User info</h2>
					<p>
						E-mail address: <%= authenticatedUser.email %>
					</p>
					<p>
						User ID: <%= authenticatedUser.id %>
					</p>
					<p>
						Permissions: <%= (authenticatedUser.permissions.toArray() ? authenticatedUser.permissions.toArray().join(', ') : 'No permissions granted.') %>
					</p>
					<p>
						Registered on: <%= (new Date(authenticatedUser.date)).toDateString() %>
					</p>
					<p>
						<form action="api/logout" method="POST">
							<input type="submit" value="Log out">
						</form>
					</p>
					<p>
						<a href="pwchange">Change password</a>
					</p>
				</div>
			</div>

			<%- include ('footer.ejs') %>
		</div>
	</body>
</html>
