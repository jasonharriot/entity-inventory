<!DOCTYPE html>

<html>
	<head>
		<link rel="stylesheet" href="style/style.css" />
		<link rel="stylesheet" href="style/fields.css" />
		<link rel="stylesheet" href="style/tables.css" />
		<link rel="stylesheet" href="style/list.css" />

		<meta name="viewport" content="width=device-width,initial-scale=1.0">

		<title>Card List</title>
	</head>
	<body>
		<div id="container">
			<div id="header" class="section">
				<div>
					<div>
						<h1><%= config.get("site_name"); %></h1>
					</div>
					<div>
						<h2>
							<a class="backArrow" href=".">
								← Home
							</a>
						</h2>
					</div>
				</div>
				<div class="scanDiv">
					<img src="img/scanner-bw.png" width="100px">
					<p>Scan a tag at any time to view its details.</p>
				</div>
			</div>

			<div id="contentContainer">
				<div class="section">
					<h2>Entity card list</h2>

					<p id="pTableMessage">
						<% if(authenticatedUser){%>
							<i>loading...</i>
						<%} else{%>
							You must be logged in and have permission to view cards.
						<%}%>
						</p>

					<div class="cardTableContainer">
						<table id="cardListTable" class="cardTable">
							<tbody id="cardTableBody">
								<!--Auto-populated-->
							</tbody>
						</table>
					</div>

				</div>
			</div>

			<div id="footer" class="section">
				<div>
					<p>EDAC Labs, Inc.</p>
				</div>
			</div>
		</div>

		<script type="text/javascript" src="js/func-sample-id-string.js">
		</script>
		<script type="text/javascript" src="js/moment.js"></script>
		<script type="text/javascript" src="js/func-create-card-list-table-header.js"></script>
		<script type="text/javascript" src="js/func-create-card-list-table-row.js"></script>
		<script type="text/javascript" src="js/func-parse-date.js"></script>
		<script type="text/javascript" src="js/func-compare-cards-by-date.js"></script>
		<script type="text/javascript" src="js/page-card-list.js"></script>
		<script type="text/javascript" src="js/page-scan-watch.js"></script>
		<script type="text/javascript" src="js/page-scan-default.js"></script>
	</body>
</html>
