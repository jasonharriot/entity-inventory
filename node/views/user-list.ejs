<!DOCTYPE html>

<html>
	<head>
		<link rel="stylesheet" href="style/style.css" />
		<link rel="stylesheet" href="style/tables.css" />

		<meta name="viewport" content="width=device-width,initial-scale=1.0">

		<title>User list</title>
	</head>
	<body>
		<div id="container">
			<%- include('header.ejs') %>

			<div id="contentContainer">
				<div class="section">
					<h2>User list</h2>
					<div class="generalTableContainer">
						<table class="generalTable">
							<tbody>
								<tr>
									<th>User ID</th>
									<th>E-mail</th>
									<th>Registration date</th>
									<th>Registration IP</th>
									<th>Most recent IP</th>
									<th>Permissions</th>
								</tr>
								<% users.forEach((user, i) => { %>
									<tr class="<%= i%2 == 0 ? 'rowEven' : 'rowOdd' %>">
										<td><%= user['id'] %></td>
										<td><a href="user-manage?id=<%-user['id']%>"><%= user['email'] %></a></td>
										<td><%= user['date'] %></a></td>
										<td><%= user['registration_ip'] %></a></td>
										<td><%= user['last_ip'] %></a></td>
										<td><%= user['permissions'] %></td>
									</tr>
								<% }); %>
							</tbody>
						</table>
					</div>
				</div>
			</div>

			<%- include('footer.ejs') %>
		</div>
	</body>
</html>
